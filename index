    function handleSaveJurnal(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSaveJurnal');
      btn.disabled = true;

      const submitJurnalPayload = (dokumentasiUrl) => {
        btn.innerText = 'Menyimpan...';
        const payload = {
          jurnalID: document.getElementById('jurnalID').value,
          ekskulID: document.getElementById('jurnalEkskul').value,
          tanggal: document.getElementById('jurnalTanggal').value,
          materi: document.getElementById('jurnalMateri').value,
          catatan: document.getElementById('jurnalCatatan').value,
          evaluasi: document.getElementById('jurnalEvaluasi').value,
          dokumentasi: dokumentasiUrl || '-',
          semester: appSettings.semester,
          tahunAjaran: appSettings.tahunAjaran
        };

        google.script.run
          .withSuccessHandler(res => {
            btn.disabled = false;
            btn.innerText = 'Simpan Jurnal';
            if (res.success) {
              showAlert(res.message, 'success');
              clearSelectedMedia();
              closeJurnalModal();
              loadJurnalList();
            } else {
              showAlert(res.message, 'error');
            }
          })
          .withFailureHandler(err => {
            btn.disabled = false;
            btn.innerText = 'Simpan Jurnal';
            showAlert(err.message, 'error');
          })
          .saveJurnal(currentUser, payload);
      };

      if (selectedJurnalMedia) {
        btn.innerText = 'Mengunggah Foto / Video...';
        google.script.run
          .withSuccessHandler(uploadRes => {
            if (uploadRes.success) {
              submitJurnalPayload(uploadRes.url);
            } else {
              btn.disabled = false;
              btn.innerText = 'Simpan Jurnal';
              showAlert(uploadRes.message, 'error');
            }
          })
          .withFailureHandler(err => {
            btn.disabled = false;
            btn.innerText = 'Simpan Jurnal';
            showAlert('Gagal mengunggah dokumentasi: ' + err.message, 'error');
          })
          .uploadDokumentasiDrive(selectedJurnalMedia.base64Data, selectedJurnalMedia.fileName, selectedJurnalMedia.mimeType);
      } else {
        submitJurnalPayload('-');
      }
    }

    function handleDeleteJurnal(id) {
      if (!confirm('Yakin ingin menghapus jurnal ini?')) return;
      google.script.run
        .withSuccessHandler(res => {
          if (res.success) {
            showAlert(res.message, 'success');
            loadJurnalList();
          } else {
            showAlert(res.message, 'error');
          }
        })
        .withFailureHandler(err => showAlert(err.message, 'error'))
        .deleteJurnal(currentUser, id);
    }

