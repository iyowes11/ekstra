    let currentCameraFacing = 'environment';

    function handleGalleryFileSelect(e) {
      const file = e.target.files[0];
      if (!file) return;

      if (file.size > 25 * 1024 * 1024) {
        showAlert('Ukuran file terlalu besar (Maksimal 25 MB).', 'error');
        e.target.value = '';
        return;
      }

      closeLiveCameraBox();
      const reader = new FileReader();
      reader.onload = function(evt) {
        const dataUrl = evt.target.result;
        const base64Data = dataUrl.split(',')[1];
        selectedJurnalMedia = {
          base64Data: base64Data,
          fileName: file.name,
          mimeType: file.type,
          dataUrl: dataUrl
        };
        renderSelectedMediaPreview();
      };
      reader.readAsDataURL(file);
    }

    async function startCameraStream(facingMode) {
      const camBox = document.getElementById('liveCameraBox');
      const videoEl = document.getElementById('liveVideoPreview');
      const statusEl = document.getElementById('cameraStatusText');

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        showAlert('Browser tidak mendukung akses kamera langsung.', 'error');
        return;
      }

      stopLiveCameraStream();
      try {
        liveMediaStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: facingMode },
          audio: true
        });
      } catch (err) {
        try {
          liveMediaStream = await navigator.mediaDevices.getUserMedia({
            video: { facingMode: facingMode },
            audio: false
          });
        } catch (err2) {
          try {
            liveMediaStream = await navigator.mediaDevices.getUserMedia({
              video: true,
              audio: false
            });
          } catch (err3) {
            showAlert('Izin kamera ditolak atau kamera tidak tersedia. Pastikan izin kamera diaktifkan pada browser/perangkat.', 'error');
            return;
          }
        }
      }

      videoEl.srcObject = liveMediaStream;
      if (statusEl) {
        statusEl.innerHTML = `<i class="fa-solid fa-circle text-green-400 mr-1"></i>Kamera Aktif (${facingMode === 'environment' ? 'Belakang' : 'Depan'})`;
      }
      camBox.classList.remove('hidden');
    }

    async function openLiveCameraBox() {
      await startCameraStream(currentCameraFacing);
    }

    async function switchCameraFacing() {
      currentCameraFacing = currentCameraFacing === 'environment' ? 'user' : 'environment';
      await startCameraStream(currentCameraFacing);
    }

    function stopLiveCameraStream() {
      if (liveMediaRecorder && liveMediaRecorder.state !== 'inactive') {
        try { liveMediaRecorder.stop(); } catch (_) {}
      }
      if (liveMediaStream) {
        liveMediaStream.getTracks().forEach(track => track.stop());
        liveMediaStream = null;
      }
    }

    function closeLiveCameraBox() {
      stopLiveCameraStream();
      const camBox = document.getElementById('liveCameraBox');
      if (camBox) camBox.classList.add('hidden');
      const recBadge = document.getElementById('recBadge');
      if (recBadge) recBadge.classList.add('hidden');
      const btnStart = document.getElementById('btnStartRec');
      const btnStop = document.getElementById('btnStopRec');
      if (btnStart) btnStart.classList.remove('hidden');
      if (btnStop) btnStop.classList.add('hidden');
    }

    function captureLivePhoto() {
      const videoEl = document.getElementById('liveVideoPreview');
      if (!videoEl || !liveMediaStream) return;

      const canvas = document.createElement('canvas');
      canvas.width = videoEl.videoWidth || 640;
      canvas.height = videoEl.videoHeight || 480;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(videoEl, 0, 0, canvas.width, canvas.height);

      const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
      const base64Data = dataUrl.split(',')[1];
      selectedJurnalMedia = {
        base64Data: base64Data,
        fileName: 'Foto_Live_' + Date.now() + '.jpg',
        mimeType: 'image/jpeg',
        dataUrl: dataUrl
      };

      closeLiveCameraBox();
      renderSelectedMediaPreview();
    }

    function startLiveVideoRecord() {
      if (!liveMediaStream) return;
      recordedChunks = [];
      try {
        liveMediaRecorder = new MediaRecorder(liveMediaStream);
      } catch (e) {
        showAlert('Perangkat tidak mendukung perekaman video langsung.', 'error');
        return;
      }

      liveMediaRecorder.ondataavailable = function(event) {
        if (event.data && event.data.size > 0) {
          recordedChunks.push(event.data);
        }
      };

      liveMediaRecorder.onstop = function() {
        const blob = new Blob(recordedChunks, { type: 'video/webm' });
        const reader = new FileReader();
        reader.onload = function(evt) {
          const dataUrl = evt.target.result;
          const base64Data = dataUrl.split(',')[1];
          selectedJurnalMedia = {
            base64Data: base64Data,
            fileName: 'Video_Live_' + Date.now() + '.webm',
            mimeType: 'video/webm',
            dataUrl: dataUrl
          };
          closeLiveCameraBox();
          renderSelectedMediaPreview();
        };
        reader.readAsDataURL(blob);
      };

      liveMediaRecorder.start();
      document.getElementById('recBadge').classList.remove('hidden');
      document.getElementById('btnStartRec').classList.add('hidden');
      document.getElementById('btnStopRec').classList.remove('hidden');
    }

    function stopLiveVideoRecord() {
      if (liveMediaRecorder && liveMediaRecorder.state !== 'inactive') {
        liveMediaRecorder.stop();
      }
    }

    function renderSelectedMediaPreview() {
      const container = document.getElementById('mediaPreviewContainer');
      const nameEl = document.getElementById('mediaPreviewName');
      const elBox = document.getElementById('mediaPreviewElement');

      if (!selectedJurnalMedia) {
        container.classList.add('hidden');
        return;
      }

      nameEl.innerText = selectedJurnalMedia.fileName;
      if (selectedJurnalMedia.mimeType.startsWith('video/')) {
        elBox.innerHTML = `<video src="${selectedJurnalMedia.dataUrl}" controls class="max-h-48 w-auto rounded"></video>`;
      } else {
        elBox.innerHTML = `<img src="${selectedJurnalMedia.dataUrl}" alt="Pratinjau" class="max-h-48 w-auto object-contain rounded">`;
      }
      container.classList.remove('hidden');
    }

