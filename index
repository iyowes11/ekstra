    function setUserStatus(targetID, status) {
      google.script.run
        .withSuccessHandler(res => {
          if (res.success) {
            showAlert(res.message, 'success');
            refreshMasterSelects(() => renderUsersManagement());
          } else {
            showAlert(res.message, 'error');
          }
        })
        .updateUserStatus(currentUser, targetID, status);
    }

