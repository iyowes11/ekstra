    function openEkskulModal(id = '', nama = '', jadwal = '', pelatihID = '') {
      document.getElementById('ekskulModalTitle').innerText = id ? 'Edit Ekstrakurikuler' : 'Tambah Ekstrakurikuler Baru';
      document.getElementById('customEkskulID').value = id;
      document.getElementById('customNamaEkskul').value = nama;
      document.getElementById('customJadwalEkskul').value = jadwal;

      const selectPelatih = document.getElementById('customPelatihEkskul');
      let optionsHtml = `<option value="">-- Belum Ditentukan --</option>`;
      (masterSelects.pelatih || []).forEach(p => {
        const alreadyAssignedOther = p.assignedEkskulID && String(p.assignedEkskulID) !== String(id);
        optionsHtml += `<option value="${p.pelatihID}" ${String(p.pelatihID) === String(pelatihID) ? 'selected' : ''} ${alreadyAssignedOther ? 'disabled' : ''}>
          ${p.nama}${alreadyAssignedOther ? ' (Sudah Membina Ekstra Lain)' : ''}
        </option>`;
      });
      selectPelatih.innerHTML = optionsHtml;

      document.getElementById('ekskulModal').classList.remove('hidden');
    }

    function closeEkskulModal() {
      document.getElementById('ekskulModal').classList.add('hidden');
    }

    function handleSaveEkskulCustom(e) {
      e.preventDefault();
      const btn = document.getElementById('btnSaveEkskul');
      btn.disabled = true;
      btn.innerText = 'Menyimpan...';

      const payload = {
        ekskulID: document.getElementById('customEkskulID').value,
        namaEkskul: document.getElementById('customNamaEkskul').value.trim(),
        jadwal: document.getElementById('customJadwalEkskul').value.trim(),
        pelatihID: document.getElementById('customPelatihEkskul').value
      };

      google.script.run
        .withSuccessHandler(res => {
          btn.disabled = false;
          btn.innerText = 'Simpan';
          if (res.success) {
            showAlert(res.message, 'success');
            closeEkskulModal();
            refreshMasterSelects(() => loadEkskulCustomTable());
          } else {
            showAlert(res.message, 'error');
          }
        })
        .withFailureHandler(err => {
          btn.disabled = false;
          btn.innerText = 'Simpan';
          showAlert(err.message, 'error');
        })
        .saveEkskulCustom(currentUser, payload);
    }

    function handleDeleteEkskulCustom(ekskulID, namaEkskul) {
      if (!confirm(`Yakin ingin menghapus ekstrakurikuler "${namaEkskul}" dari daftar pilihan?`)) return;
      google.script.run
        .withSuccessHandler(res => {
          if (res.success) {
            showAlert(res.message, 'success');
            refreshMasterSelects(() => loadEkskulCustomTable());
          } else {
            showAlert(res.message, 'error');
          }
        })
        .withFailureHandler(err => showAlert(err.message, 'error'))
        .deleteEkskulCustom(currentUser, ekskulID);
    }

