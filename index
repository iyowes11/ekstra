    function loadPresensiTable() {
      const ekskulID = document.getElementById('presEkskul').value;
      const tanggal = document.getElementById('presTanggal').value;
      const container = document.getElementById('presensiTableContainer');

      if (!ekskulID || !tanggal) {
        showAlert('Pilih ekstrakurikuler dan tanggal terlebih dahulu!', 'error');
        return;
      }

      container.innerHTML = `<p class="text-center text-xs text-gray-500 py-4"><i class="fa-solid fa-spinner fa-spin"></i> Memuat daftar siswa...</p>`;

      google.script.run
        .withSuccessHandler(siswaList => {
          google.script.run
            .withSuccessHandler(existingPresensi => {
              if (siswaList.length === 0) {
                container.innerHTML = `<p class="text-center text-xs text-gray-400 py-6">Belum ada siswa terdaftar pada ekstrakurikuler ini.</p>`;
                return;
              }

              let html = `
                <table class="w-full text-left text-sm border-collapse">
                  <thead>
                    <tr class="bg-gray-100 text-xs uppercase text-gray-600 border-b">
                      <th class="p-3">No</th>
                      <th class="p-3">Nama Siswa</th>
                      <th class="p-3">Kelas</th>
                      <th class="p-3 text-center">Status Presensi</th>
                    </tr>
                  </thead>
                  <tbody>
              `;

              siswaList.forEach((s, idx) => {
                const ex = existingPresensi.find(p => String(p.siswaID) === String(s.siswaID));
                const currentStatus = ex ? ex.statusPresensi : 'H';

                html += `
                  <tr class="border-b hover:bg-gray-50">
                    <td class="p-3 font-medium text-xs text-gray-500">${idx + 1}</td>
                    <td class="p-3 font-semibold text-gray-800">${s.nama}</td>
                    <td class="p-3 text-xs text-gray-600">${s.kelas}</td>
                    <td class="p-3 text-center">
                      ${currentUser.role === 'SISWA' ? 
                        `<span class="px-3 py-1 rounded-full text-xs font-bold ${
                          currentStatus === 'H' ? 'bg-green-100 text-green-800' :
                          currentStatus === 'S' ? 'bg-yellow-100 text-yellow-800' :
                          currentStatus === 'I' ? 'bg-blue-100 text-blue-800' : 'bg-red-100 text-red-800'
                        }">${currentStatus}</span>` :
                        `<div class="inline-flex space-x-2 text-xs font-semibold">
                          ${['H','S','I','A'].map(st => `
                            <label class="cursor-pointer">
                              <input type="radio" name="pres_${s.siswaID}" value="${st}" ${currentStatus === st ? 'checked' : ''} class="mr-1">
                              ${st}
                            </label>
                          `).join('')}
                        </div>`
                      }
                    </td>
                  </tr>
                `;
              });

              html += `</tbody></table>`;

              if (currentUser.role !== 'SISWA') {
                html += `
                  <div class="mt-6 text-right">
                    <button onclick="savePresensiData('${ekskulID}', '${tanggal}')" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2.5 rounded-lg text-sm font-semibold shadow">
                      <i class="fa-solid fa-floppy-disk mr-2"></i> Simpan Presensi
                    </button>
                  </div>
                `;
              }

              container.innerHTML = html;
            })
            .getExistingPresensi(currentUser, ekskulID, tanggal);
        })
        .withFailureHandler(err => showAlert(err.message, 'error'))
        .getSiswaForPresensi(currentUser, ekskulID);
    }

    function savePresensiData(ekskulID, tanggal) {
      const container = document.getElementById('presensiTableContainer');
      const inputs = container.querySelectorAll('input[type="radio"]:checked');
      
      let records = [];
      inputs.forEach(inp => {
        const siswaID = inp.name.replace('pres_', '');
        records.push({
          siswaID: siswaID,
          statusPresensi: inp.value
        });
      });

      const payload = {
        ekskulID: ekskulID,
        tanggal: tanggal,
        semester: appSettings.semester,
        tahunAjaran: appSettings.tahunAjaran,
        records: records
      };

      google.script.run
        .withSuccessHandler(res => {
          if (res.success) {
            showAlert(res.message, 'success');
          } else {
            showAlert(res.message, 'error');
          }
        })
        .withFailureHandler(err => showAlert(err.message, 'error'))
        .savePresensi(currentUser, payload);
    }

