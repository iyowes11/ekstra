    function printReportOnly() {
      const printContent = document.getElementById('printArea').innerHTML;
      const printWindow = window.open('', '_blank', 'width=900,height=650');
      if (printWindow) {
        printWindow.document.open();
        printWindow.document.write(`
          <!DOCTYPE html>
          <html lang="id">
          <head>
            <meta charset="UTF-8">
            <title>Cetak Laporan SMADITA</title>
            <script src="https://cdn.tailwindcss.com"><\/script>
            <style>
              body { font-family: sans-serif; padding: 20px; background: white; color: #111827; }
              table { width: 100%; border-collapse: collapse; margin-top: 12px; }
              th, td { border: 1px solid #374151; padding: 6px 8px; font-size: 12px; }
              th { background-color: #f3f4f6; font-weight: bold; }
              @media print {
                @page { margin: 12mm; }
                body { padding: 0; }
              }
            </style>
          </head>
          <body onload="setTimeout(function(){ window.print(); window.close(); }, 500);">
            ${printContent}
          </body>
          </html>
        `);
        printWindow.document.close();
      } else {
        // Fallback jika pop-up diblokir browser (menggunakan @media print CSS)
        window.print();
      }
    }

    function refreshCurrentReport() {
      if (currentReportType) generateReport(currentReportType);
    }

    function generateReport(type) {
      currentReportType = type;
      const wrapper = document.getElementById('reportPreviewWrapper');
      const printArea = document.getElementById('printArea');
      const filterEkskul = document.getElementById('repFilterEkskul') ? document.getElementById('repFilterEkskul').value : '';

      wrapper.classList.remove('hidden');
      printArea.innerHTML = `<p class="text-center text-xs text-gray-500 py-8"><i class="fa-solid fa-spinner fa-spin mr-2"></i>Mengambil data laporan dari database...</p>`;

      const kopSurat = `
        <div class="border-b-2 border-gray-800 pb-4 mb-6 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <img src="https://i.ibb.co.com/3ysFVhxP/IMG-5d0357f5-f1cf-4422-b59c-402168b0b72f.png" alt="Logo" class="h-14 w-auto">
            <div>
              <h3 class="font-bold text-base sm:text-lg text-gray-900 uppercase">SMAS Diponegoro Tumpang (SMADITA)</h3>
              <p class="text-xs text-gray-600">Laporan Resmi Ekstrakurikuler | Semester ${appSettings.semester} Tahun Ajaran ${appSettings.tahunAjaran}</p>
            </div>
          </div>
        </div>
      `;

      if (type === 'PELATIHAN') {
        google.script.run
          .withSuccessHandler(data => {
            currentReportData = data;
            let rows = data.length === 0 
              ? `<tr><td colspan="6" class="p-4 text-center text-xs text-gray-400">Tidak ada data jurnal latihan ditemukan.</td></tr>`
              : data.map((j, i) => `
                  <tr class="border-b">
                    <td class="p-2 text-xs text-center">${i + 1}</td>
                    <td class="p-2 text-xs">${j.tanggal}</td>
                    <td class="p-2 text-xs font-semibold">${j.namaEkskul}</td>
                    <td class="p-2 text-xs">${j.namaPelatih}</td>
                    <td class="p-2 text-xs">${j.materi}</td>
                    <td class="p-2 text-xs">${j.catatan || '-'} / Eval: ${j.evaluasi || '-'}</td>
                  </tr>
                `).join('');

            printArea.innerHTML = `
              ${kopSurat}
              <h4 class="font-bold text-center text-sm uppercase mb-4">LAPORAN KEGIATAN & JURNAL PELATIHAN EKSTRAKURIKULER</h4>
              <table class="w-full text-left border-collapse border text-xs">
                <thead>
                  <tr class="bg-gray-100 border-b">
                    <th class="p-2 border text-center">No</th>
                    <th class="p-2 border">Tanggal</th>
                    <th class="p-2 border">Ekstrakurikuler</th>
                    <th class="p-2 border">Pelatih</th>
                    <th class="p-2 border">Materi Latihan</th>
                    <th class="p-2 border">Catatan & Evaluasi</th>
                  </tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            `;
          })
          .getJurnalList(currentUser, filterEkskul || null);

      } else if (type === 'KEHADIRAN') {
        google.script.run
          .withSuccessHandler(data => {
            currentReportData = data;
            let rows = data.length === 0 
              ? `<tr><td colspan="8" class="p-4 text-center text-xs text-gray-400">Tidak ada data kehadiran ditemukan.</td></tr>`
              : data.map((r, i) => `
                  <tr class="border-b">
                    <td class="p-2 text-xs text-center">${i + 1}</td>
                    <td class="p-2 text-xs font-semibold">${r.nama}</td>
                    <td class="p-2 text-xs text-center">${r.kelas}</td>
                    <td class="p-2 text-xs text-center">${r.hadir}</td>
                    <td class="p-2 text-xs text-center">${r.sakit}</td>
                    <td class="p-2 text-xs text-center">${r.izin}</td>
                    <td class="p-2 text-xs text-center">${r.alpa}</td>
                    <td class="p-2 text-xs text-center font-bold">${r.persentase}% (${r.hadir}/${r.total})</td>
                  </tr>
                `).join('');

            printArea.innerHTML = `
              ${kopSurat}
              <h4 class="font-bold text-center text-sm uppercase mb-4">LAPORAN REKAPITULASI KEHADIRAN SISWA</h4>
              <table class="w-full text-left border-collapse border text-xs">
                <thead>
                  <tr class="bg-gray-100 border-b">
                    <th class="p-2 border text-center">No</th>
                    <th class="p-2 border">Nama Siswa</th>
                    <th class="p-2 border text-center">Kelas</th>
                    <th class="p-2 border text-center">Hadir</th>
                    <th class="p-2 border text-center">Sakit</th>
                    <th class="p-2 border text-center">Izin</th>
                    <th class="p-2 border text-center">Alpa</th>
                    <th class="p-2 border text-center">Persentase</th>
                  </tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            `;
          })
          .getRekapKehadiran(currentUser, filterEkskul || null, appSettings.semester, appSettings.tahunAjaran);

      } else if (type === 'NILAI') {
        google.script.run
          .withSuccessHandler(data => {
            currentReportData = data;
            let rows = data.length === 0 
              ? `<tr><td colspan="7" class="p-4 text-center text-xs text-gray-400">Tidak ada data nilai ditemukan.</td></tr>`
              : data.map((n, i) => `
                  <tr class="border-b">
                    <td class="p-2 text-xs text-center">${i + 1}</td>
                    <td class="p-2 text-xs font-semibold">${n.namaSiswa}</td>
                    <td class="p-2 text-xs text-center">${n.kelas}</td>
                    <td class="p-2 text-xs">${n.namaEkskul}</td>
                    <td class="p-2 text-xs text-center font-bold">${n.angka}</td>
                    <td class="p-2 text-xs text-center font-bold">${n.predikat}</td>
                    <td class="p-2 text-xs">${n.catatan}</td>
                  </tr>
                `).join('');

            printArea.innerHTML = `
              ${kopSurat}
              <h4 class="font-bold text-center text-sm uppercase mb-4">LAPORAN PENILAIAN EKSTRAKURIKULER SISWA</h4>
              <table class="w-full text-left border-collapse border text-xs">
                <thead>
                  <tr class="bg-gray-100 border-b">
                    <th class="p-2 border text-center">No</th>
                    <th class="p-2 border">Nama Siswa</th>
                    <th class="p-2 border text-center">Kelas</th>
                    <th class="p-2 border">Ekstrakurikuler</th>
                    <th class="p-2 border text-center">Nilai</th>
                    <th class="p-2 border text-center">Predikat</th>
                    <th class="p-2 border">Catatan Perkembangan</th>
                  </tr>
                </thead>
                <tbody>${rows}</tbody>
              </table>
            `;
          })
          .getNilaiData(currentUser, filterEkskul || null, appSettings.semester, appSettings.tahunAjaran);
      }
    }

    function exportReportCSV() {
      if (!currentReportData || currentReportData.length === 0) {
        showAlert('Tidak ada data untuk diekspor ke CSV!', 'error');
        return;
      }

      const headers = Object.keys(currentReportData[0]);
      const csvRows = [headers.join(',')];

      currentReportData.forEach(row => {
        const values = headers.map(h => `"${String(row[h] || '').replace(/"/g, '""')}"`);
        csvRows.push(values.join(','));
      });

      const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `Laporan_${currentReportType}_SMADITA.csv`;
      link.click();
      URL.revokeObjectURL(url);
    }

