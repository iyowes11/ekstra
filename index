<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aplikasi Ekstrakurikuler SMADITA</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            smaditaRed: '#8B0000',
            smaditaRedHover: '#6B0000',
            smaditaLight: '#F9FAFB',
            smaditaGray: '#4B5563'
          }
        }
      }
    }
  </script>
  <style>
    @media print {
      @page {
        size: auto;
        margin: 12mm;
      }
      html, body {
        height: auto !important;
        overflow: visible !important;
        background: white !important;
      }
      /* Sembunyikan seluruh elemen utama web saat print */
      #topNavbar, #sidebarNav, footer, #alertBox, .no-print {
        display: none !important;
      }
      main, #viewContainer, #reportPreviewWrapper, .main-card-wrapper {
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        box-shadow: none !important;
        width: 100% !important;
        max-width: 100% !important;
        display: block !important;
      }
      #printArea {
        display: block !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        background: white !important;
      }
    }
  </style>
</head>
<body class="bg-gray-100 font-sans text-gray-800 antialiased min-h-screen flex flex-col">

  <!-- TOP HEADER / NAVBAR -->
  <header id="topNavbar" class="hidden bg-smaditaRed text-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <button id="hamburgerBtn" onclick="toggleSidebar()" class="text-white focus:outline-none md:hidden">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
        <div class="flex items-center space-x-2">
          <img src="https://i.ibb.co.com/3ysFVhxP/IMG-5d0357f5-f1cf-4422-b59c-402168b0b72f.png" alt="Logo SMADITA" class="h-8 w-auto">
          <span class="font-bold text-lg tracking-wide hidden sm:inline">EKSKUL SMADITA</span>
        </div>
      </div>
      <div class="flex items-center space-x-4">
        <div class="text-right text-xs sm:text-sm">
          <span id="navUserName" class="font-semibold block">User</span>
          <span id="navUserRole" class="text-red-200 text-xs uppercase">Role</span>
        </div>
        <button onclick="logout()" class="bg-red-900 hover:bg-black text-white text-xs px-3 py-1.5 rounded transition">
          <i class="fa-solid fa-right-from-bracket"></i> Logout
        </button>
      </div>
    </div>
  </header>

  <div class="flex flex-1 relative">
    <!-- SIDEBAR NAV -->
    <aside id="sidebarNav" class="hidden fixed md:relative z-40 w-64 bg-white border-r min-h-screen shadow-sm transition-all">
      <div class="p-4 border-b bg-gray-50 flex justify-between items-center">
        <span class="font-bold text-gray-700 text-sm"><i class="fa-solid fa-compass mr-2"></i>NAVIGASI</span>
        <button onclick="toggleSidebar()" class="md:hidden text-gray-500"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <nav id="menuList" class="p-4 space-y-1 text-sm">
        <!-- Rendered dynamically by JS -->
      </nav>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 p-4 md:p-6 max-w-7xl mx-auto w-full">
      <!-- GLOBAL NOTIFICATION ALERT -->
      <div id="alertBox" class="hidden mb-4 p-4 rounded-lg text-sm flex justify-between items-center transition-all">
        <span id="alertMessage"></span>
        <button onclick="closeAlert()"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <!-- VIEW CONTAINER -->
      <div id="viewContainer">
        <!-- Views injected here -->
      </div>
    </main>
  </div>

  <!-- FOOTER -->
  <footer class="bg-white border-t py-4 text-center text-xs text-gray-500 mt-auto">
    <p>&copy; 2026 SMAS Diponegoro Tumpang (SMADITA) | Ujian Praktik Informatika</p>
  </footer>

  <!-- SCRIPT LOGIC -->
  <script>
    // ==========================================
    // KONFIGURASI GOOGLE SHEET (HOSTING GITHUB)
    // Tempel URL lengkap atau ID Google Sheet Anda di bawah ini:
    // Contoh URL: https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOpQrStUvWxYz/edit
    // Contoh ID : 1AbCdEfGhIjKlMnOpQrStUvWxYz
    // ==========================================
    const GSHEET_URL_OR_ID = 'AKfycbxu8RhK6RXa8Q1VrQgOwqe6982RQ3ijKqf4VBauvL6zDTq08CJLeriMw5DNbLCM1IyC';
    const APPS_SCRIPT_WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbxu8RhK6RXa8Q1VrQgOwqe6982RQ3ijKqf4VBauvL6zDTq08CJLeriMw5DNbLCM1IyC/exec';

    function extractGsheetId(input) {
      if (!input || input === 'TEMPEL_URL_ATAU_ID_GSHEET_ANDA_DI_SINI') return '';
      const match = String(input).trim().match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
      return match ? match[1] : String(input).trim();
    }

    const ACTIVE_GSHEET_ID = extractGsheetId(GSHEET_URL_OR_ID);

    // Fallback mock agar aplikasi tetap dapat dijalankan saat mode Preview di luar Google Apps Script
    if (typeof window.google === 'undefined' || !window.google.script) {
      window.google = {
        script: {
          run: new Proxy({}, {
            get(_, prop) {
              if (prop === 'withSuccessHandler' || prop === 'withFailureHandler') {
                return function(cb) {
                  if (prop === 'withSuccessHandler') this._onSuccess = cb;
                  return this;
                };
              }
              return function(...args) {
                const onSuccess = this._onSuccess || function() {};
                const mockDB = {
                  ekskul: [
                    { ekskulID: 'EKS-001', namaEkskul: 'Pramuka', jadwal: 'Jumat, 14.30 WIB', pelatihID: '', namaPelatih: '', hasCoach: false },
                    { ekskulID: 'EKS-002', namaEkskul: 'Paskibra', jadwal: 'Sabtu, 08.00 WIB', pelatihID: '', namaPelatih: '', hasCoach: false },
                    { ekskulID: 'EKS-003', namaEkskul: 'Futsal', jadwal: 'Rabu, 15.30 WIB', pelatihID: '', namaPelatih: '', hasCoach: false }
                  ],
                  pelatih: [],
                  siswa: []
                };
                setTimeout(() => {
                  switch (prop) {
                    case 'getPublicEkskulList':
                      onSuccess(mockDB.ekskul);
                      break;
                    case 'loginUser':
                      onSuccess({
                        success: true,
                        user: { userID: 'USR-ADMIN', username: args[0] || 'admin', fullName: 'Administrator Preview', role: 'ADMIN', refID: 'ADM-01', ekskulID: '' }
                      });
                      break;
                    case 'registerUser':
                      onSuccess({ success: true, message: 'Registrasi simulasi berhasil! Silakan login.' });
                      break;
                    case 'getMasterSelects':
                      onSuccess(mockDB);
                      break;
                    case 'getDashboardData':
                      onSuccess({
                        settings: { semester: 'Ganjil', tahunAjaran: '2026/2027' },
                        stats: { totalSiswa: 0, totalPelatih: 0, totalEkskul: mockDB.ekskul.length, pendingUsers: 0 },
                        assignedEkskul: [],
                        myEkskul: []
                      });
                      break;
                    case 'getAllEkskulDetail':
                      onSuccess(mockDB.ekskul);
                      break;
                    case 'uploadDokumentasiDrive':
                      onSuccess({ success: true, url: '#preview-media-uploaded' });
                      break;
                    case 'saveEkskulCustom':
                    case 'deleteEkskulCustom':
                    case 'savePresensi':
                    case 'saveJurnal':
                    case 'deleteJurnal':
                    case 'saveNilai':
                    case 'updateUserStatus':
                    case 'saveSettings':
                      onSuccess({ success: true, message: 'Data berhasil disimpan (Mode Preview).' });
                      break;
                    default:
                      onSuccess([]);
                  }
                }, 150);
              };
            }
          })
        }
      };
    }

    // Global State
    let currentUser = null;
    let masterSelects = { ekskul: [], pelatih: [], siswa: [] };
    let appSettings = { semester: 'Ganjil', tahunAjaran: '2026/2027' };
    let publicEkskulList = [];
    let currentReportData = [];
    let currentReportType = '';

    // Initial Load
    window.onload = function() {
      const savedUser = localStorage.getItem('smadita_user');
      if (savedUser) {
        currentUser = JSON.parse(savedUser);
        initDashboard();
      } else {
        renderLogin();
      }
    };

    function showAlert(msg, type = 'success') {
      const box = document.getElementById('alertBox');
      const msgEl = document.getElementById('alertMessage');
      box.className = `mb-4 p-4 rounded-lg text-sm flex justify-between items-center transition-all ${
        type === 'success' ? 'bg-green-100 border border-green-300 text-green-800' : 'bg-red-100 border border-red-300 text-red-800'
      }`;
      msgEl.innerText = msg;
      box.classList.remove('hidden');
      setTimeout(() => box.classList.add('hidden'), 5000);
    }

    function closeAlert() {
      document.getElementById('alertBox').classList.add('hidden');
    }

    function toggleSidebar() {
      const sidebar = document.getElementById('sidebarNav');
      sidebar.classList.toggle('hidden');
    }

    function refreshMasterSelects(callback) {
      google.script.run
        .withSuccessHandler(data => {
          masterSelects = data;
          if (callback) callback();
        })
        .getMasterSelects(currentUser);
    }

    // ==========================================
    // AUTHENTICATION VIEWS
    // ==========================================

    function renderLogin() {
      document.getElementById('topNavbar').classList.add('hidden');
      document.getElementById('sidebarNav').classList.add('hidden');

      const container = document.getElementById('viewContainer');
      container.innerHTML = `
        <div class="max-w-md mx-auto mt-8 bg-white p-8 rounded-xl shadow-lg border border-gray-100">
          <div class="text-center mb-6">
            <img src="https://i.ibb.co.com/3ysFVhxP/IMG-5d0357f5-f1cf-4422-b59c-402168b0b72f.png" alt="Logo SMADITA" class="h-20 mx-auto mb-3">
            <h2 class="text-2xl font-bold text-smaditaRed">EKSTRAKURIKULER SMADITA</h2>
            <p class="text-xs text-gray-500 mt-1">SMAS Diponegoro Tumpang - Kab. Malang</p>
          </div>

          <form onsubmit="handleLogin(event)" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
              <input type="text" id="loginUsername" required class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-smaditaRed">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Password</label>
              <div class="relative">
                <input type="password" id="loginPassword" required class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-smaditaRed">
                <button type="button" onclick="togglePassword('loginPassword')" class="absolute right-3 top-2.5 text-gray-400 text-xs">
                  <i class="fa-solid fa-eye"></i>
                </button>
              </div>
            </div>
            <button type="submit" id="btnLogin" class="w-full bg-smaditaRed hover:bg-smaditaRedHover text-white py-2.5 rounded-lg text-sm font-semibold transition">
              <i class="fa-solid fa-right-to-bracket mr-2"></i> Masuk
            </button>
          </form>

          <div class="mt-6 text-center text-xs text-gray-500 border-t pt-4">
            Belum punya akun? <button onclick="renderRegister()" class="text-smaditaRed font-semibold hover:underline">Registrasi Akun</button>
          </div>
        </div>
      `;
    }

    function renderRegister() {
      const container = document.getElementById('viewContainer');
      container.innerHTML = `<div class="text-center py-8"><i class="fa-solid fa-spinner fa-spin text-2xl text-smaditaRed"></i><p class="text-xs text-gray-500 mt-2">Memuat Form Registrasi...</p></div>`;

      google.script.run
        .withSuccessHandler(list => {
          publicEkskulList = list;
          container.innerHTML = `
            <div class="max-w-md mx-auto mt-6 bg-white p-8 rounded-xl shadow-lg border border-gray-100">
              <div class="text-center mb-6">
                <h2 class="text-xl font-bold text-smaditaRed">Pendaftaran Akun Baru</h2>
                <p class="text-xs text-gray-500">Daftar sebagai Pelatih atau Siswa</p>
              </div>

              <form onsubmit="handleRegister(event)" class="space-y-4">
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1">Daftar Sebagai</label>
                  <select id="regRole" required class="w-full border rounded-lg px-3 py-2 text-sm bg-white" onchange="toggleRefIDInput()">
                    <option value="PELATIH">Pelatih Ekstrakurikuler</option>
                    <option value="SISWA">Siswa</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Lengkap</label>
                  <input type="text" id="regFullName" required class="w-full border rounded-lg px-3 py-2 text-sm">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
                  <input type="text" id="regUsername" required class="w-full border rounded-lg px-3 py-2 text-sm">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1">Password</label>
                  <input type="password" id="regPassword" required class="w-full border rounded-lg px-3 py-2 text-sm">
                </div>
                
                <div id="divEkskulSelect">
                  <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblEkskulSelect">Pilih Ekstrakurikuler yang Dibina (1 Pelatih = 1 Ekstra)</label>
                  <select id="regEkskulID" class="w-full border rounded-lg px-3 py-2 text-sm bg-white">
                    <option value="">-- Pilih Ekstrakurikuler --</option>
                    ${publicEkskulList.map(e => `<option value="${e.ekskulID}" data-hascoach="${e.hasCoach ? '1' : '0'}">${e.namaEkskul}${e.hasCoach ? ' (Sudah Ada Pelatih)' : ''}</option>`).join('')}
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblRefID">ID Pelatih / NIP</label>
                  <input type="text" id="regRefID" class="w-full border rounded-lg px-3 py-2 text-sm" placeholder="Masukkan ID atau NIP">
                </div>

                <button type="submit" id="btnReg" class="w-full bg-smaditaRed hover:bg-smaditaRedHover text-white py-2.5 rounded-lg text-sm font-semibold transition">
                  Daftar Sekarang
                </button>
              </form>

              <div class="mt-4 text-center text-xs text-gray-500">
                Sudah punya akun? <button onclick="renderLogin()" class="text-smaditaRed font-semibold hover:underline">Kembali ke Login</button>
              </div>
            </div>
          `;
          toggleRefIDInput();
        })
        .getPublicEkskulList();
    }

    function toggleRefIDInput() {
      const role = document.getElementById('regRole').value;
      const lbl = document.getElementById('lblRefID');
      const input = document.getElementById('regRefID');
      const lblEkskul = document.getElementById('lblEkskulSelect');
      const selectEkskul = document.getElementById('regEkskulID');

      if (selectEkskul) {
        Array.from(selectEkskul.options).forEach(opt => {
          if (opt.value) {
            const hasCoach = opt.getAttribute('data-hascoach') === '1';
            const cleanName = opt.text.replace(' (Sudah Ada Pelatih)', '');
            if (role === 'PELATIH' && hasCoach) {
              opt.disabled = true;
              opt.text = cleanName + ' (Sudah Ada Pelatih)';
            } else {
              opt.disabled = false;
              opt.text = cleanName;
            }
          }
        });
        if (role === 'PELATIH' && selectEkskul.selectedOptions[0] && selectEkskul.selectedOptions[0].disabled) {
          selectEkskul.value = '';
        }
      }

      if (role === 'SISWA') {
        lbl.innerText = 'NISN / ID Siswa';
        input.placeholder = 'Masukkan NISN';
        if (lblEkskul) lblEkskul.innerText = 'Pilih Ekstrakurikuler yang Diikuti (Opsional)';
      } else {
        lbl.innerText = 'ID Pelatih / NIP';
        input.placeholder = 'Masukkan ID atau NIP';
        if (lblEkskul) lblEkskul.innerText = 'Pilih Ekstrakurikuler yang Dibina (1 Pelatih = 1 Ekstra)';
      }
    }

    function togglePassword(id) {
      const input = document.getElementById(id);
      input.type = input.type === 'password' ? 'text' : 'password';
    }

    function handleLogin(e) {
      e.preventDefault();
      const u = document.getElementById('loginUsername').value;
      const p = document.getElementById('loginPassword').value;
      const btn = document.getElementById('btnLogin');
      btn.disabled = true;
      btn.innerText = 'Memproses...';

      google.script.run
        .withSuccessHandler(res => {
          btn.disabled = false;
          btn.innerText = 'Masuk';
          if (res.success) {
            currentUser = res.user;
            localStorage.setItem('smadita_user', JSON.stringify(currentUser));
            initDashboard();
          } else {
            showAlert(res.message, 'error');
          }
        })
        .withFailureHandler(err => {
          btn.disabled = false;
          btn.innerText = 'Masuk';
          showAlert(err.message, 'error');
        })
        .loginUser(u, p);
    }

    function handleRegister(e) {
      e.preventDefault();
      const role = document.getElementById('regRole').value;
      const ekskulID = document.getElementById('regEkskulID') ? document.getElementById('regEkskulID').value : '';

      if (role === 'PELATIH' && !ekskulID) {
        showAlert('Harap pilih 1 ekstrakurikuler yang dibina!', 'error');
        return;
      }

      const data = {
        fullName: document.getElementById('regFullName').value,
        username: document.getElementById('regUsername').value,
        password: document.getElementById('regPassword').value,
        role: role,
        refID: document.getElementById('regRefID').value,
        ekskulID: ekskulID
      };

      const btn = document.getElementById('btnReg');
      btn.disabled = true;
      btn.innerText = 'Mendaftarkan...';

      google.script.run
        .withSuccessHandler(res => {
          btn.disabled = false;
          btn.innerText = 'Daftar Sekarang';
          if (res.success) {
            showAlert(res.message, 'success');
            renderLogin();
          } else {
            showAlert(res.message, 'error');
          }
        })
        .withFailureHandler(err => {
          btn.disabled = false;
          btn.innerText = 'Daftar Sekarang';
          showAlert(err.message, 'error');
        })
        .registerUser(data);
    }

    function logout() {
      localStorage.removeItem('smadita_user');
      currentUser = null;
      renderLogin();
    }

    // ==========================================
    // DASHBOARD & MENU NAVIGATION
    // ==========================================

    function initDashboard() {
      document.getElementById('topNavbar').classList.remove('hidden');
      document.getElementById('sidebarNav').classList.remove('hidden');
      document.getElementById('navUserName').innerText = currentUser.fullName;
      document.getElementById('navUserRole').innerText = currentUser.role;

      renderSidebarMenu();
      refreshMasterSelects();
      loadDashboardHome();
    }

    function renderSidebarMenu() {
      const menu = document.getElementById('menuList');
      let html = '';

      const items = {
        ADMIN: [
          { id: 'dash', label: 'Dashboard', icon: 'fa-gauge' },
          { id: 'ekskul_custom', label: 'Kelola Ekstrakurikuler', icon: 'fa-futbol' },
          { id: 'presensi', label: 'Presensi', icon: 'fa-calendar-check' },
          { id: 'jurnal', label: 'Jurnal Kegiatan', icon: 'fa-book' },
          { id: 'nilai', label: 'Penilaian Siswa', icon: 'fa-star' },
          { id: 'rekap', label: 'Rekap Kehadiran', icon: 'fa-chart-pie' },
          { id: 'laporan', label: 'Laporan', icon: 'fa-file-lines' },
          { id: 'users', label: 'Kelola Pengguna', icon: 'fa-users-gear' },
          { id: 'settings', label: 'Pengaturan Semester', icon: 'fa-sliders' },
          { id: 'about', label: 'About', icon: 'fa-circle-info' }
        ],
        PELATIH: [
          { id: 'dash', label: 'Dashboard', icon: 'fa-gauge' },
          { id: 'presensi', label: 'Presensi Siswa', icon: 'fa-calendar-check' },
          { id: 'jurnal', label: 'Jurnal Kegiatan', icon: 'fa-book' },
          { id: 'nilai', label: 'Penilaian Ekstra', icon: 'fa-star' },
          { id: 'rekap', label: 'Rekap Kehadiran', icon: 'fa-chart-pie' },
          { id: 'laporan', label: 'Laporan Pelatihan', icon: 'fa-file-lines' },
          { id: 'about', label: 'About', icon: 'fa-circle-info' }
        ],
        SISWA: [
          { id: 'dash', label: 'Dashboard', icon: 'fa-gauge' },
          { id: 'presensi', label: 'Presensi Saya', icon: 'fa-calendar-check' },
          { id: 'rekap', label: 'Rekap Presensi', icon: 'fa-chart-pie' },
          { id: 'nilai', label: 'Nilai Saya', icon: 'fa-star' },
          { id: 'jurnal', label: 'Jurnal Kegiatan', icon: 'fa-book' },
          { id: 'about', label: 'About', icon: 'fa-circle-info' }
        ]
      };

      (items[currentUser.role] || []).forEach(item => {
        html += `
          <button onclick="navigateMenu('${item.id}')" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-gray-600 hover:bg-red-50 hover:text-smaditaRed transition">
            <i class="fa-solid ${item.icon} w-5"></i>
            <span class="font-medium">${item.label}</span>
          </button>
        `;
      });

      menu.innerHTML = html;
    }

    function navigateMenu(menuId) {
      if (window.innerWidth < 768) {
        document.getElementById('sidebarNav').classList.add('hidden');
      }

      switch (menuId) {
        case 'dash': loadDashboardHome(); break;
        case 'ekskul_custom': renderEkskulCustomModule(); break;
        case 'presensi': renderPresensiModule(); break;
        case 'jurnal': renderJurnalModule(); break;
        case 'nilai': renderNilaiModule(); break;
        case 'rekap': renderRekapModule(); break;
        case 'laporan': renderLaporanModule(); break;
        case 'users': renderUsersManagement(); break;
        case 'settings': renderSettingsModule(); break;
        case 'about': renderAboutPage(); break;
      }
    }

    function loadDashboardHome() {
      const container = document.getElementById('viewContainer');
      container.innerHTML = `<div class="text-center py-8"><i class="fa-solid fa-spinner fa-spin text-2xl text-smaditaRed"></i><p class="text-xs text-gray-500 mt-2">Memuat Dashboard...</p></div>`;

      google.script.run
        .withSuccessHandler(data => {
          appSettings = data.settings || appSettings;
          if (currentUser.role === 'ADMIN') {
            container.innerHTML = `
              <div class="mb-6">
                <h1 class="text-xl font-bold text-gray-800">Dashboard Administrator</h1>
                <p class="text-xs text-gray-500">Tahun Ajaran: ${appSettings.tahunAjaran} | Semester: ${appSettings.semester}</p>
              </div>

