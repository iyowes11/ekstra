          if (list.length === 0) {
            container.innerHTML = `<p class="text-center text-xs text-gray-400 py-6">Belum ada pilihan ekstrakurikuler.</p>`;
            return;
          }

          let html = `
            <table class="w-full text-left text-sm border-collapse">
              <thead>
                <tr class="bg-gray-100 text-xs uppercase text-gray-600 border-b">
                  <th class="p-3">Kode</th>
